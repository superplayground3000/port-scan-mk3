# Copy to .env only if you want to override defaults. All values have working
# defaults baked into the compose file and the scanner script.

# Target IP on the isolated lab network (must match the subnet in
# docker-compose.yml and client/inputs/cidr.csv).
TARGET_IP=172.31.199.10

# Port the target listens on (open) and a port nothing listens on (closed).
OPEN_PORT=9000
CLOSED_PORT=9001
